# Salin menjadi .env lalu isi. Jangan pernah commit file .env.
NODE_ENV=development
PORT=4000

# Lokal: mongodb://127.0.0.1:27017/pouk_immanuel
# Atlas: mongodb+srv://<user>:<password>@<cluster>/pouk_immanuel
MONGODB_URI=mongodb://127.0.0.1:27017/pouk_immanuel

# Wajib, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Hanya untuk klien web (aplikasi mobile native tidak memerlukan CORS). Pisahkan dengan koma.
CORS_ORIGINS=

# Jumlah reverse proxy di depan server (mis. 1 bila memakai Nginx/Render/Railway), agar rate limit membaca IP asli.
TRUST_PROXY=0

# Folder penyimpanan gambar unggahan. Harus berada di disk persisten.
UPLOAD_DIR=uploads
