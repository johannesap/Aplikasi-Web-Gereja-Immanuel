# Salin menjadi .env. Hanya variabel EXPO_PUBLIC_* yang masuk ke aplikasi — jangan taruh rahasia di sini.
# Emulator Android : http://10.0.2.2:4000
# Simulator iOS    : http://localhost:4000
# HP fisik (Wi-Fi sama dengan laptop): http://<IP-laptop>:4000, mis. http://192.168.1.10:4000
# Produksi         : https://api.domain-gereja.org  (wajib HTTPS)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
